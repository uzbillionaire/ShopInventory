# Template for the real .env file. This one is safe to commit; .env is NOT.
#
#   cp .env.example .env     then fill in real values on the server.
#
# Generate a secret key with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

# ---------- Django ----------
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
# Domains and/or server IP that may serve this app. Comma separated, no spaces.
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
# Same list, but with the scheme. Needed for logging into /admin/ over https.
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# Set to 0 until you have a TLS certificate, otherwise the site redirects
# to https and nothing answers there yet. Flip to 1 after certbot succeeds.
DJANGO_SECURE_SSL=0
# Leave at 0 until https is confirmed working, then raise to 31536000 (one year).
DJANGO_HSTS_SECONDS=0

DJANGO_LOG_LEVEL=INFO

# ---------- PostgreSQL ----------
POSTGRES_DB=shopinventory
POSTGRES_USER=shopinventory
# This password gets embedded into a URL, so avoid @ : / # ? and spaces.
# Safest way to produce one:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=replace-me-with-a-strong-password

# ---------- Proxies ----------
# How many proxies forward requests to Django: 2 behind Caddy + nginx (this server),
# 1 if nginx faces the internet directly. Used to find the real visitor IP for login limits.
DJANGO_PROXY_COUNT=2

# ---------- gunicorn ----------
# Rule of thumb: (2 x CPU cores) + 1. A small 1-core VPS is happy with 3.
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# ---------- Shared server ----------
# Docker network that the existing Caddy proxy lives on, so it can reach us.
# Find it with: docker inspect cinevault-caddy-1 --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}'
EDGE_NETWORK=cinevault_default
